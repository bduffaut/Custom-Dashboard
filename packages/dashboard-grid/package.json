{
  "name": "custom-dashboard-grid",
  "version": "0.2.0",
  "description": "Draggable, resizable dashboard grid for Vue 3. Give it widgets, it handles the rest.",
  "keywords": [
    "vue",
    "vue3",
    "grid",
    "dashboard",
    "drag",
    "resize",
    "layout",
    "widgets"
  ],
  "license": "MIT",
  "author": "Benjamin Duffaut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bduffaut/Custom-Dashboard.git",
    "directory": "packages/dashboard-grid"
  },
  "homepage": "https://github.com/bduffaut/Custom-Dashboard#readme",
  "bugs": {
    "url": "https://github.com/bduffaut/Custom-Dashboard/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && vue-tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n js,types -c blue,cyan \"vite build --watch\" \"vue-tsc -p tsconfig.build.json --watch --preserveWatchOutput\"",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
