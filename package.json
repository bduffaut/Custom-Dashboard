{
  "name": "custom-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "npm run build -w custom-dashboard-grid && concurrently -k -n lib,app -c blue,green \"npm run dev -w custom-dashboard-grid\" \"npm run dev -w playground\"",
    "build": "npm run build -w custom-dashboard-grid && npm run build -w playground",
    "test": "npm run test -w custom-dashboard-grid",
    "test:run": "npm run test:run -w custom-dashboard-grid",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.4",
    "jsdom": "^30.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.12"
  }
}
